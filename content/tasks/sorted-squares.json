  "description": [
    {
      "p": "Дан массив <code>nums</code>, отсортированный в неубывающем порядке. Нужно вернуть отсортированный массив, состоящий из всех элементов массива <code>nums</code>, возведенных в квадрат."
    },
    {
      "h": "Пример 1:"
    },
    {
      "pre": "Ввод: nums = [-3,-2,0,1,3,5]\nВывод: [0,1,4,9,9,25]"
    },
    {
      "h": "Пример 2:"
    },
    {
      "pre": "Ввод: nums = [-5,-3,-1]\nВывод: [1,9,25]"
    },
    {
      "h": "Ограничения:"
    },
    {
      "ul": [
        "<code>len(nums) >= 1</code>"
      ]
    }
  ],
  "solutionNotes": null,
  "solution": null,
  "signature": {
    "name": "sortedSquares",
    "params": [
      {
        "name": "nums",
        "type": "[]int"
      }
    ],
    "returns": "[]int"
  },
  "tests": [
    {
