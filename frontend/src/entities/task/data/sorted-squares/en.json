{
  "title": "Sorted Squares",
  "description": [
    {
      "p": "You are given an array <code>nums</code> sorted in non-decreasing order. Return a sorted array of the squares of all elements of <code>nums</code>."
    },
    {
      "h": "Example 1:"
    },
    {
      "pre": "Input: nums = [-3,-2,0,1,3,5]\nOutput: [0,1,4,9,9,25]"
    },
    {
      "h": "Example 2:"
    },
    {
      "pre": "Input: nums = [-5,-3,-1]\nOutput: [1,9,25]"
    },
    {
      "h": "Constraints:"
    },
    {
      "ul": [
        "<code>len(nums) >= 1</code>"
      ]
    }
  ]
}
