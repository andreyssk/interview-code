{
  "title": "Reverse String",
  "description": [
    {
      "p": "You are given a list of characters <code>chars</code>. Reverse <code>chars</code> and return the modified list as the answer. Using a built-in reverse function is not allowed."
    },
    {
      "h": "Example 1:"
    },
    {
      "pre": "Input: chars = [\"p\",\"e\",\"r\",\"f\",\"e\",\"c\",\"t\",\"i\",\"o\",\"n\"]\nOutput: [\"n\",\"o\",\"i\",\"t\",\"c\",\"e\",\"f\",\"r\",\"e\",\"p\"]"
    },
    {
      "h": "Example 2:"
    },
    {
      "pre": "Input: chars = [\"r\",\"e\",\"v\",\"e\",\"r\",\"s\",\"e\"]\nOutput: [\"e\",\"s\",\"r\",\"e\",\"v\",\"e\",\"r\"]"
    },
    {
      "h": "Constraints:"
    },
    {
      "ul": [
        "<code>len(chars) >= 0</code>",
        "<code>chars</code> contains only ASCII characters"
      ]
    }
  ],
  "solution": [
    {
      "h": "Complexity estimate"
    },
    {
      "ul": [
        "Time: <code>O(n)</code>, where <code>n</code> is the length of <code>chars</code>",
        "Space: <code>O(1)</code>"
      ]
    }
  ]
}
